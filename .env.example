# local requires pip install '.[local]' and a pre-cached MiniLM model.
# hash is the deterministic offline demonstration and CI baseline.
EMBEDDER=hash
RETRIEVAL_ENABLED=true
AUTO_CONFIDENCE=0.90
AUTO_LIMIT_CENTS=500000
POP_RETENTION_DAYS=30
