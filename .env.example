AGENT_DATABASE_URL=postgresql+psycopg://clearline_agent:local-agent-only@localhost:54329/clearline
MIGRATION_DATABASE_URL=postgresql+psycopg://clearline_owner:local-owner-only@localhost:54329/clearline
API_KEY=clearline-local-demo
CLEARLINE_API_PORT=18000
CLEARLINE_WEB_PORT=5173
CLEARLINE_DB_PORT=54329
LLM_PROVIDER=stub
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
MIMO_BASE_URL=
MIMO_API_KEY=
